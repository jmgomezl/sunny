# /etc/nginx/sites-available/sunny.aivylabs
# Sunny's Telegram Mini App (static). The bot runs under PM2 as sunny-bot and uses
# long polling, so it needs no route here.
# HTTP only: certbot --nginx adds the TLS server block and the redirect.
server {
    server_name sunny.aivylabs.xyz;
    listen 80;
    listen [::]:80;

    root /var/www/sunny;
    index index.html;

    # Hashed build files never change, so browsers can keep them for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # A single-page app: every other path is the app itself.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
