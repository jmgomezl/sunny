# Copy to .env and fill in. Never commit .env.

# OpenRouter: https://openrouter.ai/workspaces/default/keys (set a credit limit on the key)
OPENROUTER_API_KEY=
# Sunny's brain. Cheap, fast and reliable at tool calls; swap any OpenRouter model id here.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Telegram: create the bot with @BotFather and paste its token here
TELEGRAM_BOT_TOKEN=

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
