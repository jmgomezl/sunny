# Copy to .env and fill in. Never commit .env.

# OpenRouter: https://openrouter.ai/workspaces/default/keys (set a credit limit on the key)
OPENROUTER_API_KEY=
# Sunny's brain. Cheap, fast and reliable at tool calls; swap any OpenRouter model id here.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Telegram: create the bot with @BotFather and paste its token here
TELEGRAM_BOT_TOKEN=

# Where Sunny's Mini App is served (the Telegram menu button opens it)
MINI_APP_URL=https://sunny.aivylabs.xyz

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com

# Pocket money on devnet. `pnpm --dir bot devnet-setup` creates these and writes them here:
# Sunny's fee wallet (base58 secret key): pays network fees and rent, and mints test USDC
SUNNY_FEE_PAYER=
# Secret that derives Sunny's agent key for each pocket owner (32 random bytes, hex)
SUNNY_AGENT_SEED=
# Test-USDC mint on devnet (mint authority: the fee wallet)
SUNNY_USDC_MINT=

# Optional
# SOLANA_MAINNET_RPC_URL=   # for watched wallets; defaults to the public mainnet RPC
# SUNNY_API_PORT=8820       # the Mini App's API
# SUNNY_DATA_DIR=./data     # where users, alerts and wallet backups are stored
# BOT_POLLING=off           # API only, without polling Telegram
